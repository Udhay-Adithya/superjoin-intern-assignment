{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "outDir": "app/web/static/js",
    "rootDir": "web/ts",
    "sourceMap": false,
    "declaration": false,
    "skipLibCheck": true
  },
  "include": ["web/ts/**/*.ts"]
}
