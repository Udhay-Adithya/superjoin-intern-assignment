# NVIDIA NIM (OpenAI-compatible endpoint)
NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# model used for bulk fact extraction (fast instruct model)
NIM_EXTRACT_MODEL=

# model used to adjudicate flagged conflicts (reasoning model, low volume)
NIM_ADJUDICATE_MODEL=

# storage
DB_PATH=data/facts.db
UPLOAD_DIR=data/uploads

# cache llm responses by content hash so re-runs cost nothing
LLM_CACHE_DIR=.cache/llm
LLM_CACHE_ENABLED=true
