# --- LLM backend -----------------------------------------------------------
# Any OpenAI-compatible endpoint. Pick one block below and fill in the key.
#
# Groq        https://api.groq.com/openai/v1        ~500-1200 tok/s, free tier
# Cerebras    https://api.cerebras.ai/v1            ~1000-2000 tok/s, free tier
# NVIDIA NIM  https://integrate.api.nvidia.com/v1   ~7-28 tok/s
#
# Speed matters more than it looks: extraction is thousands of output tokens per
# page, so a slow endpoint turns a five-minute corpus run into several hours.

LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1

# Bulk fact extraction: hundreds of calls. Wants speed and reliable JSON.
LLM_EXTRACT_MODEL=openai/gpt-oss-120b

# Conflict adjudication and document metadata: tens of calls. Wants judgement.
LLM_ADJUDICATE_MODEL=openai/gpt-oss-120b

# Reasoning models spend max_tokens on thinking before answering, and extraction
# is a copying task that does not benefit from it. Set low (or none) where the
# provider supports it; leave blank to send nothing.
LLM_REASONING_EFFORT=low

# --- storage ---------------------------------------------------------------
DB_PATH=data/facts.db
UPLOAD_DIR=data/uploads

# --- llm response cache ----------------------------------------------------
# Keyed by content hash, so re-running the corpus after a non-LLM change is free.
LLM_CACHE_DIR=.cache/llm
LLM_CACHE_ENABLED=true
